    "@prisma/client": "^7.8.0",
    "@scalar/fastify-api-reference": "^1.55.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "ws": "^8.20.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
