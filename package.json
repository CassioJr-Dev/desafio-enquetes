  "main": "server.ts",
  "scripts": {
    "test": "vitest run tests --environment node --pool threads --maxWorkers 1",
    "test:watch": "vitest watch tests --environment node --pool threads --maxWorkers 1",
    "test:unit": "vitest run tests/unit --environment node --pool threads --maxWorkers 1",
    "test:unit:usecases": "vitest run tests/unit/pollModule/useCases --environment node --pool threads --maxWorkers 1",
    "test:unit:controllers": "vitest run tests/unit/pollModule/controllers --environment node --pool threads --maxWorkers 1",
    "test:e2e": "vitest run tests/e2e/poll.e2e.spec.ts --environment node --pool threads --maxWorkers 1",
    "test:e2e:websocket": "vitest run tests/e2e/poll.websocket.e2e.spec.ts --environment node --pool threads --maxWorkers 1",
    "dev": "tsx watch src/server.ts",
    "deploy:prod": "node scripts/deploy-production.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "prod": "npm run build && npm run start"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fastify/swagger": "^9.7.0",
